# ──────────────────────────────────────────────────────────────────────────────
# Base de datos PostgreSQL
# ──────────────────────────────────────────────────────────────────────────────

# Inicialización del contenedor PostgreSQL en docker-compose.prod.yml.
# En producción usa valores propios y no versionados.
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# Desarrollo local (contenedor Docker en localhost)
DATABASE_URL="postgresql://onestar:onestar_pass@localhost:5432/onestar?schema=public"
DIRECT_URL="postgresql://onestar:onestar_pass@localhost:5432/onestar?schema=public"
DATABASE_STARTUP_MAX_ATTEMPTS="12" # Intentos de conexión antes de abortar el contenedor Docker
DATABASE_STARTUP_RETRY_SECONDS="5" # Espera entre intentos; hasta 11 pausas con 12 intentos
DATABASE_STARTUP_PROBE_TIMEOUT_SECONDS="5" # Máximo de segundos para cada sondeo de conexión

# Docker Compose (los servicios se comunican por nombre de servicio, no localhost)
# DATABASE_URL="postgresql://onestar:onestar_pass@db:5432/onestar?schema=public"
# DIRECT_URL="postgresql://onestar:onestar_pass@db:5432/onestar?schema=public"

# Producción serverless con Supabase — DOS URLs distintas, no son intercambiables:
#   DATABASE_URL → pooler (Supavisor), puerto 6543, modo transaction.
#                  Lo usa el runtime. Sin ?pgbouncer=true Prisma intenta usar
#                  prepared statements y el pooler los rechaza.
#   DIRECT_URL   → conexión directa, puerto 5432. La usa `prisma migrate`, que
#                  necesita una sesión real (un pooler en modo transaction no
#                  soporta DDL transaccional ni advisory locks).
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────────────────────────
# Autenticación (better-auth)
# ──────────────────────────────────────────────────────────────────────────────

AUTH_SECRET=""                    # Secret de sesiones — generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""             # Alias soportado por auth.ts
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción ambas URLs deben ser el dominio público real con https://. Si no
# coinciden con el dominio desde el que se sirve la app, las cookies de sesión se
# descartan y el login falla en silencio.

# ──────────────────────────────────────────────────────────────────────────────
# Usuario administrador inicial (usado por prisma db seed)
# ──────────────────────────────────────────────────────────────────────────────

ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ──────────────────────────────────────────────────────────────────────────────
# Almacenamiento de imágenes (Cloudinary)
# ──────────────────────────────────────────────────────────────────────────────

STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ──────────────────────────────────────────────────────────────────────────────
# Chatbot de ventas (ver src/server/services/ai-chat.service.ts)
# ──────────────────────────────────────────────────────────────────────────────
# Sin ANTHROPIC_API_KEY, el chat responde "no disponible" en vez de romper la página.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5" # opcional; default ya es este modelo

# ──────────────────────────────────────────────────────────────────────────────
# Integración ERP (agnóstica — ver src/server/erp/)
# ──────────────────────────────────────────────────────────────────────────────

ERP_PROVIDER="null"               # "null" | "alegra" | "siigo" | "loggro"
ALEGRA_EMAIL=""                   # Email de la cuenta Alegra
ALEGRA_API_KEY=""                 # API Key de Alegra
LOGGRO_API_TOKEN=""               # Token Bearer de conexión para Loggro Pymes
LOGGRO_BASE_URL="https://api.loggro.com"
LOGGRO_ESTABLECIMIENTO_UUID=""    # (opcional) se auto-detecta si se omite
LOGGRO_BODEGA_UUID=""             # (opcional) se auto-detecta si se omite
LOGGRO_STOCK_SCOPE="all"          # "all" suma tiendas; "primary" usa la sede principal
LOGGRO_IVA_RATE="0.19"            # Loggro entrega precios SIN IVA; la web lo suma (0 desactiva)
ERP_CATALOG_WRITES_ENABLED="false" # Mantener false hasta aprobar la reparación del catálogo
DISABLE_INTERNAL_CRON=""          # "1" apaga los cron internos (solo si usas un disparador externo)
CRON_SECRET=""                    # Protege /api/cron/sync-erp. OBLIGATORIA en producción:
                                  # sin ella el endpoint responde 503 (fail-closed).

# ──────────────────────────────────────────────────────────────────────────────
# Correos transaccionales (Resend — ver src/server/email/)
# ──────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=""
EMAIL_FROM="One Star <onboarding@resend.dev>"
# onboarding@resend.dev solo entrega correos a la dirección dueña de la cuenta
# Resend. Para escribirle a clientes reales hace falta un dominio verificado.

# ──────────────────────────────────────────────────────────────────────────────
# ePayco (pasarela de pagos)
# ──────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_EPAYCO_PUBLIC_KEY=""  # Llave pública del dashboard de ePayco
EPAYCO_PRIVATE_KEY=""             # Llave privada (solo servidor) para firmar el webhook
EPAYCO_CUSTOMER_ID=""             # p_cust_id_cliente
NEXT_PUBLIC_EPAYCO_TEST="true"    # "true" en pruebas/staging, "false" en producción real

# ──────────────────────────────────────────────────────────────────────────────
# Sentry (observabilidad — opcional en desarrollo)
# ──────────────────────────────────────────────────────────────────────────────

SENTRY_DSN=""                     # DSN del proyecto (server)
NEXT_PUBLIC_SENTRY_DSN=""         # DSN público (bundle del cliente)
SENTRY_ORG=""                     # Slug de la organización
SENTRY_PROJECT=""                 # Slug del proyecto
SENTRY_AUTH_TOKEN=""              # Token para subir source maps durante el build
